#!/usr/bin/env bash
# Conventional Commits check (docs/ENGINEERING_WORKFLOW.md §10).
#
#   check-commit-messages [base-ref]     default base: origin/main
set -uo pipefail
cd "$(dirname "$0")/.."

BASE="${1:-origin/main}"
PATTERN='^(feat|fix|refactor|docs|test|chore)(\([a-z0-9._/-]+\))?!?: .+'

git rev-parse --verify --quiet "$BASE" >/dev/null || {
    echo "commit-messages: unknown base ref '$BASE'" >&2; exit 1; }

bad=0
while IFS= read -r subject; do
    [ -n "$subject" ] || continue
    if ! printf '%s' "$subject" | grep -Eq "$PATTERN"; then
        echo "commit-messages: not a conventional commit: $subject" >&2
        bad=$((bad + 1))
    fi
done <<EOF
$(
    # Merge subjects are exempt: CI checks out GitHub's synthetic PR merge
    # ref, whose "Merge <sha> into <sha>" commit is not authored work.
    git log --no-merges --format='%s' "$BASE"..HEAD
)
EOF

if [ "$bad" -ne 0 ]; then
    echo "" >&2
    echo "Expected: feat|fix|refactor|docs|test|chore(scope): summary" >&2
    exit 1
fi

echo "commit-messages: OK"
