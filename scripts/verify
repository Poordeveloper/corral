#!/usr/bin/env bash
# THE merge gate. There is exactly one definition of merge-ready
# verification and this is it (AGENTS.md §Verification).
#
# A failure here is information. Do not skip, loosen, or retry a check to
# make it pass: repair the cause, or formally quarantine it with human
# approval (docs/ENGINEERING_WORKFLOW.md §6.2).
set -euo pipefail
cd "$(dirname "$0")/.."

./scripts/verify-fast

# Test-only seams live behind this non-default feature; see
# scripts/check-test-support-boundary for the other half of that boundary.
TEST_SUPPORT="corral/test-support,corrald/test-support"

# `cargo test --all-targets` compiles a bin as a unit-test harness under
# deps/; it does not place the runnable binary at target/<profile>/<name>.
# The end-to-end suite starts real `corral` and `corrald` processes and
# resolves the daemon as its sibling, exactly as the product does, so the
# gate has to build them rather than hope a previous command left them
# there — a stale or missing daemon would otherwise decide what the suite
# proves.
echo "==> workspace binaries"
cargo build --workspace --features "$TEST_SUPPORT"

echo "==> full test suite"
cargo test --workspace --all-targets --features "$TEST_SUPPORT"

# --all-targets does not include doctests; without this, documented contract
# examples would never run anywhere in the verification map.
echo "==> doctests"
cargo test --workspace --doc --features "$TEST_SUPPORT"

# The fuzz crate is outside the workspace, so nothing above compiles it — and
# a gate that cannot build is a gate that silently stopped existing. Checking
# it costs seconds and needs no nightly toolchain or sanitizer.
echo "==> fuzz targets compile"
(cd fuzz && cargo check --quiet)

echo "==> test-support boundary"
./scripts/check-test-support-boundary

echo "==> dependency direction"
./scripts/check-dependency-direction

echo "==> dependency hygiene"
if ! command -v cargo-deny >/dev/null 2>&1; then
    echo "cargo-deny is required by the merge gate but is not installed." >&2
    echo "Install it with: cargo install cargo-deny --locked" >&2
    exit 1
fi
cargo deny --version
cargo deny check

echo "verify: OK"
